.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Raw downloaded source documents (large, reproducible from CELLAR)
data/raw/

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Written by Chainlit into its app root at startup. Only the English translation is kept,
# because it carries this app's wording; the others are copied fresh from the package.
src/euaia/chat/.files/
src/euaia/chat/.chainlit/translations/*
!src/euaia/chat/.chainlit/translations/en-US.json

# Local logs and scratch output
*.log

# Generated by `python -m eval.harness`; regenerate rather than track.
eval_report.json
# Generated by `python -m eval.rerankers`.
eval_pools.json
eval_rerank_scores.json
eval_rerank_report.json
eval_e2e_*.json

# Reranker model weights. ~2.3 GB, downloaded from the Hugging Face Hub on first use and
# reproducible from `rerank_model` in config.py -- never commit them. The default cache is
# outside the repo (HF_HOME / ~/.cache/huggingface); these entries cover the case where a
# local HF_HOME is pointed inside the project, which the README suggests for offline use.
.cache/
models/
*.safetensors
*.onnx
*.bin

# Hugging Face / torch scratch
.hf_home/
huggingface/
