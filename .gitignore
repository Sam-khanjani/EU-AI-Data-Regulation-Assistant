# Local logs and scratch output
*.log

# Generated by `python -m eval.harness`; regenerate rather than track.
eval_report.json

# Reranker model weights. ~2.3 GB, downloaded from the Hugging Face Hub on first use and
# reproducible from `rerank_model` in config.py -- never commit them. The default cache is
# outside the repo (HF_HOME / ~/.cache/huggingface); these entries cover the case where a
# local HF_HOME is pointed inside the project, which the README suggests for offline use.
.cache/
models/
*.safetensors
*.onnx
*.bin

# Hugging Face / torch scratch
.hf_home/
huggingface/
