# Copy to .env and fill in.

# --- Models ---
GROQ_API_KEY=
GOOGLE_API_KEY=

# --- Database ---
# Pick any password for the local dev container; docker-compose.yml reads it from here.
# Host port 5433 (below) avoids clashing with a local Postgres on 5432.
POSTGRES_PASSWORD=
# 127.0.0.1, not localhost: docker-compose binds IPv4 only, and 'localhost' resolves to
# ::1 first. Nothing listens there, and Docker Desktop drops rather than refuses the
# packet, so every connection waits out a ~2 minute TCP timeout before falling back.
DATABASE_URL=postgresql+psycopg://euaia:<same value as POSTGRES_PASSWORD>@127.0.0.1:5433/euaia

# --- Admin auth (gates /status: corpus contents, change detection) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Chat (python -m euaia.chat, http://127.0.0.1:8001) ---
# Who may sign in: comma-separated name:password pairs, e.g. alice:first-password,bob:second.
# Empty refuses everyone. Passwords may contain ':' but not ','.
CHAT_USERS=
# Signs chat sessions. Generate one with: uv run chainlit create-secret
CHAINLIT_AUTH_SECRET=

# --- Optional overrides (defaults live in src/euaia/config.py) ---
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_SMALL_MODEL=openai/gpt-oss-20b
# EMBED_MODEL=gemini-embedding-001

# --- Reranking ---
# Which reranker is used is set in src/euaia/config.py (rerank_provider), not here. The
# default is hosted on OpenRouter and needs this key; with rerank_provider = "local" it is
# not used.
OPENROUTER_API_KEY=
